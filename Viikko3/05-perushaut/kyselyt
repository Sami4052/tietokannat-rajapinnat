USE employees;
SELECT dept_name FROM departments;

b)Nimikkeet kerran mitä title tietokannassa on
SELECT DISTINCT title FROM titles;

c)suurin ja pienin nykyinen palkka
SELECT MAX(salary) AS suurin_palkka, MIN(salary) AS pienin_palkka FROM salaries;

d)keskimääräinen palkka
SELECT AVG(salary) AS keskiarvo_palkka FROM salaries;

e)Kaikki työntekijät joiden sukunimi on Facello.
SELECT * FROM employees WHERE last_name = 'Facello';

f)kuinka moni syntynyt 1950-luvulla
SELECT COUNT(*) AS syntyneet_1950_luvulla FROM employees WHERE birth_date BETWEEN '1950-01-01' AND '1959-12-31';

g)Montako miestä ja naista työntekijöissä on
SELECT gender, COUNT(*) AS maara FROM employees GROUP BY gender;